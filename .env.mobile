# Build-time config for every static client build — the GitHub Pages site and
# the Capacitor app both run `vite build --mode mobile`, so this file is named
# for that mode. Vite only reads `.env.<mode>`, so naming it `.env.production`
# means it is silently ignored.
#
# These two are the Supabase project URL and *publishable* (anon) key. They are
# embedded in the browser bundle by design and are safe in the repo — row level
# security is what protects the data, not the secrecy of this key.
#
# Deliberately absent: VITE_GOOGLE_MAPS_BROWSER_KEY. It is billable, so the
# workflow injects it from a repo secret when one is set.
VITE_SUPABASE_URL="https://xrphocnodeacddutulqe.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhycGhvY25vZGVhY2RkdXR1bHFlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc0MTYyMzMsImV4cCI6MjA5Mjk5MjIzM30.wbZoxCkjAu7k5tbUEK_I7EaxRkhqEhuhC9NuQnZXqXI"
VITE_SUPABASE_PROJECT_ID="xrphocnodeacddutulqe"
VITE_PUBLIC_SITE_URL=https://ccacbmore.com
