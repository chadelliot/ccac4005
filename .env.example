# Copy to .env and fill in. Never commit the filled-in file.

# Supabase — project URL and publishable (anon) key.
# These are safe to ship in the client bundle; RLS is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Same values, read during SSR where import.meta.env isn't available.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Maps JS API key used by the evangelism map in the browser.
# Restrict it by HTTP referrer in Google Cloud — it ships in the bundle.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_TRACKING_ID=

# Not used by the client. Set as Supabase edge function secrets instead:
#   supabase secrets set GOOGLE_MAPS_SERVER_KEY=...   (server-side geocoding)
#   supabase secrets set ANTHROPIC_API_KEY=...        (program-ai)
